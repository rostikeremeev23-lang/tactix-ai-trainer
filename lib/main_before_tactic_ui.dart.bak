// =====================================================
// DECISION RECORD
// =====================================================

class DecisionRecord {
  final int turn;
  final String decision;
  final int score;

  const DecisionRecord({
    required this.turn,
    required this.decision,
    required this.score,
  });
}

// =====================================================
// MAX
// =====================================================

int maxInt(
  int a,
  int b,
) {
  return a > b ? a : b;
}