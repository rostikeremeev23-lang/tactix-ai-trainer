                _CommandTile(
                  icon: Icons.edit_note_rounded,
                  title: 'СОЗДАТЬ',
                  subtitle: 'Новый сценарий',
                  accent: Colors.white70,
                  onTap: () => _open(context, const CreateScenarioScreen()),
                ),
                _CommandTile(
                  icon: Icons.bar_chart_rounded,
                  title: 'АНАЛИТИКА',
                  subtitle: 'Результаты',
                  accent: Colors.white70,
                  onTap: () => _open(context, const StatisticsScreen()),
                ),
              ],
            ),
            const SizedBox(height: 16),
            const _SectionLabel('СОСТОЯНИЕ СИСТЕМЫ'),
            const SizedBox(height: 8),
            const _ReadinessCard(),
            const SizedBox(height: 16),
            const _SectionLabel('МОДУЛИ'),
            const SizedBox(height: 8),
            _ModuleRow(
              icon: Icons.folder_open_rounded,
              title: 'Банк сценариев',
              subtitle: 'Локальное хранилище',
              onTap: () => _open(context, const MyScenariosScreen()),
