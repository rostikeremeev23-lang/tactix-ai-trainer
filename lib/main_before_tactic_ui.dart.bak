class HomeScreen extends StatelessWidget {
  const HomeScreen({super.key});

  static const olive = Color(0xFFA7B84A);
  static const bg = Color(0xFF0A0E0B);
  static const panel = Color(0xFF111711);
  static const line = Color(0xFF2B3528);

  void _open(BuildContext context, Widget page) {
    Navigator.push(
      context,
      MaterialPageRoute(builder: (_) => page),
