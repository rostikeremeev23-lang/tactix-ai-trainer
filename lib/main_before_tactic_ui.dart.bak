// =====================================================
// APP
// =====================================================

class AITrainerApp extends StatelessWidget {
  const AITrainerApp({super.key});

  static const _olive = Color(0xFFA7B84A);
  static const _bg = Color(0xFF0A0E0B);
  static const _panel = Color(0xFF111711);
  static const _panel2 = Color(0xFF171D16);
  static const _line = Color(0xFF2B3528);

  @override
  Widget build(BuildContext context) {
    final scheme = ColorScheme.fromSeed(
      seedColor: _olive,
      brightness: Brightness.dark,
    ).copyWith(
      primary: _olive,
      secondary: _olive,
      surface: _panel,
      outline: _line,
    );

    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'TACTIC-AI',
      theme: ThemeData(
        brightness: Brightness.dark,
        colorScheme: scheme,
        scaffoldBackgroundColor: _bg,
        useMaterial3: true,
        fontFamily: 'Arial',
        appBarTheme: const AppBarTheme(
          backgroundColor: _bg,
          foregroundColor: Colors.white,
          elevation: 0,
          centerTitle: false,
        ),
        cardTheme: CardTheme(
          color: _panel,
          elevation: 0,
          margin: EdgeInsets.zero,
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.all(Radius.circular(14)),
            side: BorderSide(color: _line),
          ),
        ),
        inputDecorationTheme: InputDecorationTheme(
          filled: true,
          fillColor: _panel2,
          border: OutlineInputBorder(
            borderRadius: BorderRadius.circular(12),
            borderSide: const BorderSide(color: _line),
          ),
          enabledBorder: OutlineInputBorder(
            borderRadius: BorderRadius.circular(12),
            borderSide: const BorderSide(color: _line),
          ),
          focusedBorder: OutlineInputBorder(
            borderRadius: BorderRadius.circular(12),
            borderSide: const BorderSide(color: _olive, width: 1.2),
          ),
        ),
      ),
      home: const HomeScreen(),
    );
  }
}

// =====================================================
